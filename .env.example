# Discord bot configuration
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Trello API configuration
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Optional: automatic Trello readiness retry backoff in milliseconds.
TRELLO_RETRY_BASE_DELAY_MS=30000
TRELLO_RETRY_MAX_DELAY_MS=300000

# Optional: override the Trello list names if your board uses different names.
TRELLO_LIST_APPEALABLE=Appealable Blacklist
TRELLO_LIST_CONDITIONAL=Conditional Blacklist
TRELLO_LIST_PERMANENT=Permanent Blacklist
TRELLO_LIST_REVOKED=Revoked Blacklist
TRELLO_LIST_GROUP=Group Blacklist

# Optional persistent role snapshot file.
ROLE_SNAPSHOT_FILE=data/role-snapshots.json
# Optional persistent Discord setup file.
BOT_SETUP_FILE=data/guild-settings.json