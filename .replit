modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DISCORD_GUILD_ID = "1114860005334716422"
TRELLO_BOARD_ID = "pqeRROcq"
TRELLO_LIST_APPEALABLE = "Appealable Blacklists"
TRELLO_LIST_CONDITIONAL = "Conditional Blacklists"
TRELLO_LIST_GROUP = "Blacklisted Groups"
TRELLO_LIST_PERMANENT = "Permanent Blacklists"
TRELLO_LIST_REVOKED = "Revoked Blacklists"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
